      "id": "152105c0-1645-4356-8207-7b0051ba7733",
      "name": "Fetch Meta Insights",
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "position": [
        -784,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const thresholds = $items(\"Read Thresholds\").map(item => item.json);\nconst memoryBank = $items(\"Read Memory Bank\").map(item => item.json);\nconst fbResponse = $input.all()[0].json.data || [];\n\nlet alerts = [];\n\nfor (const ad of fbResponse) {\n  let spend = parseFloat(ad.spend || 0);\n  let roas = 0;\n  \n  if (ad.purchase_roas && ad.purchase_roas.length > 0) {\n      roas = parseFloat(ad.purchase_roas[0].value);\n  }\n\n  let highestLevelMet = 0;\n  let levelName = \"None\";\n\n  for (const t of thresholds) {\n     if (spend >= t.Min_Spend && roas >= t.Min_ROAS) {\n         let levelNum = parseInt(t.Level_Name.replace(/[^0-9]/g, ''));\n         if (levelNum > highestLevelMet) {\n             highestLevelMet = levelNum;\n             levelName = t.Level_Name;\n         }\n     }\n  }\n\n  if (highestLevelMet > 0) {\n      const memoryRecord = memoryBank.find(m => String(m.Ad_ID) === String(ad.ad_id));\n      const prevLevel = memoryRecord ? parseInt(memoryRecord.Highest_Level_Alerted.replace(/[^0-9]/g, '')) || 0 : 0;\n\n      if (highestLevelMet > prevLevel) {\n          alerts.push({\n             json: {\n                Ad_ID: ad.ad_id,\n                Ad_Name: ad.ad_name,\n                Level_Reached: levelName,\n                Spend: spend.toFixed(2),\n                ROAS: roas.toFixed(2),\n                Timestamp: new Date().toISOString()\n             }\n          });\n      }\n  }\n}\n\nreturn alerts;"
      },
