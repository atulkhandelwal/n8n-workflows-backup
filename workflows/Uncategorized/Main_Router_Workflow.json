          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      },
      "position": [
        1000,
        200
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3
    },
    {
      "id": "extract-domain-set",
      "name": "Extract Keyword",
      "parameters": {
        "jsonOutput": "={\n  \"Business_Domain\": \"{{ $json.output.match(/\\\\[DOMAIN_CAPTURED:\\\\s*(.*?)\\\\]/)[1] }}\",\n  \"Phone\": \"{{ $('Extract Data').item.json.phone }}\"\n}",
