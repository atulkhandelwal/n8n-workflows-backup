    },
    {
      "id": "check-ai-extracted",
      "name": "Check Extraction",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "check-extracted-keyword",
              "leftValue": "={{ $json.output }}",
              "operator": {
                "operation": "contains",
                "type": "string"
              },
              "rightValue": "[DOMAIN_CAPTURED:"
