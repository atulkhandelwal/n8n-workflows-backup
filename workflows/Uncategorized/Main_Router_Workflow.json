    {
      "id": "check-registration",
      "name": "Check Registration",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "domain-exists-check",
              "leftValue": "={{ $json.Business_Domain }}",
              "operator": {
                "operation": "notEmpty",
                "type": "string"
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        }
      },
      "position": [
        600,
        0
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3
    },
    {
      "id": "router-switch",
      "name": "Domain Router",
      "parameters": {
        "options": {
          "fallbackOutput": "none"
        },
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "clothing-rule",
                    "leftValue": "={{ $json.Business_Domain }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "Clothing"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                }
              },
              "outputKey": "Clothing",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "furniture-rule",
                    "leftValue": "={{ $json.Business_Domain }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "Furniture"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                }
              },
              "outputKey": "Furniture",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "upvc-rule",
                    "leftValue": "={{ $json.Business_Domain }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "UPVC"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                }
              },
              "outputKey": "UPVC",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "realestate-rule",
                    "leftValue": "={{ $json.Business_Domain }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "Real-Estate"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                }
              },
              "outputKey": "Real-Estate",
              "renameOutput": true
            }
          ]
        }
      },
      "position": [
        800,
        -200
      ],
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4
    },
    {
      "id": "exec-clothing-wf",
      "name": "Execute Clothing Workflow",
      "parameters": {
        "mode": "each",
        "waitForSubWorkflow": false,
        "workflowId": "RnyedYNqdRpde8sb"
      },
      "position": [
        1000,
        -300
      ],
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1
    },
    {
      "id": "ai-agent",
      "name": "Domain Capture AI",
      "parameters": {
        "options": {
          "systemMessage": "You are a friendly routing assistant.\n\nYour goal is to identify the user's intent, ask for their optional Name, and their Business Domain.\n\nCRITICAL DOMAIN MAPPING RULES:\n1. The system ONLY supports exactly these 4 keywords: `Clothing`, `Furniture`, `UPVC`, `Real-Estate`.\n2. If the user gives a synonym (e.g., \"boutique\", \"garments\", \"apparel\", \"shop\"), map it to the closest supported keyword (e.g., `Clothing`).\n3. If the user's business type cannot be mapped to any of the 4 supported options, you MUST reply: \"Currently we only support chat demos for Clothing, Furniture, UPVC, and Real-Estate. Please choose one of these options.\"\n4. If the user provides a valid domain, your final response MUST end with exactly: `[DOMAIN_CAPTURED: Clothing]` (replace Clothing with the actual matched keyword). \n5. Be very brief and polite."
        },
        "promptType": "define",
        "text": "={{ $('Extract Data').item.json.message }}"
      },
      "position": [
        800,
        200
      ],
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1
    },
    {
      "id": "llm-model",
      "name": "OpenAI Chat Model",
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "position": [
        800,
        400
      ],
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3
    },
    {
      "id": "memory",
      "name": "Window Buffer Memory",
      "parameters": {
