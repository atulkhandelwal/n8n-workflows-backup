    {
      "parameters": {
        "jsCode": "const ads = $input.all();\nconst pageMap = new Map();\n\nfor (const item of ads) {\n  const ad = item.json;\n  const pid = ad.page_id;\n  \n  if (!pid || pid === 'unknown') continue;\n  \n  if (!pageMap.has(pid)) {\n    pageMap.set(pid, {\n      page_id: pid,\n      page_name: ad.page_name,\n      ad_count: 0,\n      sample_ad: ad,\n      earliest_start: ad.ad_delivery_start_time,\n      all_bodies: [],\n      landing_url: ad.ad_creative_link_url || ad.ad_snapshot_url\n    });\n  }\n  \n  const page = pageMap.get(pid);\n  page.ad_count++;\n  \n  if (ad.ad_delivery_start_time) {\n    if (!page.earliest_start || ad.ad_delivery_start_time < page.earliest_start) {\n      page.earliest_start = ad.ad_delivery_start_time;\n    }\n  }\n  \n  if (Array.isArray(ad.ad_creative_bodies)) {\n    page.all_bodies.push(...ad.ad_creative_bodies);\n  }\n}\n\nconst output = [];\nfor (const [pid, page] of pageMap.entries()) {\n  output.push({ json: page });\n}\n\nreturn output.length > 0 ? output : [{ json: { noPages: true } }];"
      },
      "id": "a0e5074b-663b-4df7-94a0-912b49e7a1e3",
      "name": "Aggregate by Page",
