    {
      "parameters": {
        "jsCode": "// Get ALL items from Apify node (each ad is a separate item)\nconst allItems = $input.all();\nconst items = [];\n\ntry {\n  // Check if we have any data\n  if (!allItems || allItems.length === 0) {\n    return [{ json: { noResults: true } }];\n  }\n  \n  // Process each ad item from the Apify node\n  for (const item of allItems) {\n    const ad = item.json;\n    \n    // Skip if no valid data\n    if (!ad || typeof ad !== 'object') {\n      continue;\n    }\n    \n    // Normalize field names (actor may use different naming conventions)\n    items.push({\n      json: {\n        page_id: ad.page_id || ad.pageId || ad.pageid || 'unknown',\n        page_name: ad.page_name || ad.pageName || ad.pagename || 'Unknown',\n        ad_id: ad.ad_id || ad.adId || ad.id || String(Date.now()),\n        ad_snapshot_url: ad.ad_snapshot_url || ad.adSnapshotUrl || ad.snapshot_url || '',\n        ad_delivery_start_time: ad.ad_delivery_start_time || ad.adDeliveryStartTime || ad.start_time || null,\n        ad_creative_bodies: ad.ad_creative_bodies || ad.adCreativeBodies || ad.bodies || [],\n        ad_creative_link_url: ad.ad_creative_link_url || ad.adCreativeLinkUrl || ad.link_url || ''\n      }\n    });\n  }\n  \n  // Return items or noResults indicator\n  if (items.length === 0) {\n    return [{ json: { noResults: true } }];\n  }\n  \n  return items;\n  \n} catch (error) {\n  return [{ json: { error: true, errorMessage: error.message } }];\n}"
      },
      "id": "5196ba99-c63d-4232-8108-ffdd7041fc45",
