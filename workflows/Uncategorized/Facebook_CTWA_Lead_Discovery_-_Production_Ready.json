      "id": "46cf9a43-b452-45a0-a368-cbb62f02b6ab",
      "name": "Fetch Landing Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -608,
        112
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst pd = item.json;\nlet html = '';\n\ntry {\n  if (item.binary && item.binary.data && item.binary.data.data) {\n    html = Buffer.from(item.binary.data.data, 'base64').toString('utf-8');\n  }\n} catch(e) {}\n\nconst WA = /(api\\.whatsapp\\.com\\/send|wa\\.me\\/|\\bwhatsapp\\b|click\\.to\\.whatsapp)/gi;\nconst JP = /\\b(jaipur|pink city)\\b/gi;\nconst PX = /(fbq\\(|fbevents)/gi;\nconst CTWA = /(click\\.to\\.whatsapp)/gi;\n\nfunction check(txt, rx) {\n  if (!txt) return false;\n  try { return rx.test(txt); } catch(e) { return false; }\n}\n\nfunction join(arr) {\n  return Array.isArray(arr) ? arr.filter(x => x).join(' ') : '';\n}\n\nconst allText = [pd.page_name || '', join(pd.all_bodies), html].join(' ');\n\nconst hasWA = check(allText, WA);\nconst hasJP = check(allText, JP);\nconst hasPX = check(html, PX);\nconst hasCTWA = check(allText, CTWA);\n\nconst cnt = pd.ad_count || 1;\nlet vol = 0;\nif (cnt >= 50) vol = 30;\nelse if (cnt >= 30) vol = 25;\nelse if (cnt >= 15) vol = 20;\nelse if (cnt >= 8) vol = 15;\nelse if (cnt >= 4) vol = 10;\nelse if (cnt >= 2) vol = 5;\n\nconst len = join(pd.all_bodies).length;\nlet soph = 0;\nif (len > 500) soph += 8;\nelse if (len > 200) soph += 5;\nelse if (len > 100) soph += 3;\n\nif ((pd.all_bodies || []).length > 5) soph += 6;\nif (html.includes('<img')) soph += 6;\nsoph = Math.min(soph, 20);\n\nlet long = 0;\nif (pd.earliest_start) {\n  try {\n    const d = Math.floor((new Date() - new Date(pd.earliest_start)) / 86400000);\n    if (d >= 90) long = 15;\n    else if (d >= 60) long = 12;\n    else if (d >= 30) long = 9;\n    else if (d >= 14) long = 6;\n    else if (d >= 7) long = 3;\n  } catch(e) {}\n}\n\nconst track = hasPX ? 15 : 0;\nconst loc = hasJP ? 10 : 0;\nconst wa = hasWA ? 10 : 0;\nconst ctwa = hasCTWA ? 10 : 0;\nconst tot = vol + soph + long + track + loc + wa + ctwa;\n\nlet inq = 'N/A';\nif (hasWA) {\n  if (tot >= 85 && vol >= 25) inq = '50+ inquiries/day';\n  else if (tot >= 75 && vol >= 20) inq = '20-50 inquiries/day';\n  else if (tot >= 65 && vol >= 15) inq = '10-20 inquiries/day';\n  else if (tot >= 50 && vol >= 10) inq = '5-10 inquiries/day';\n  else inq = '<5 inquiries/day';\n}\n\nlet pri = 'IGNORE';\nif (tot >= 80 && hasWA && hasJP) pri = 'HIGH';\nelse if (tot >= 70 && hasWA) pri = 'MEDIUM';\nelse if (tot >= 50) pri = 'LOW';\n\nif (tot < 70 && !hasWA) {\n  return [{ json: { filtered: true, reason: 'Below threshold' } }];\n}\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    page_name: pd.page_name,\n    page_id: pd.page_id,\n    ad_id: pd.sample_ad.ad_id,\n    ad_snapshot_url: pd.sample_ad.ad_snapshot_url,\n    landing_url: pd.landing_url,\n    ad_creative_count: cnt,\n    creative_types: 'Text/Image',\n    whatsapp_cta: hasWA,\n    local_signal_jaipur: hasJP,\n    pixel_present: hasPX,\n    score: tot,\n    estimated_inquiries_bucket: inq,\n    priority: pri,\n    notes: cnt + ' ads. ' + (hasCTWA ? 'CTWA! ' : '') + (hasWA ? 'WA. ' : '') + (hasJP ? 'JP.' : '')\n  }\n}];"
      },
