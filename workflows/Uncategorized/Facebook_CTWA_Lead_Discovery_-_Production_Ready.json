    {
      "parameters": {
        "jsCode": "const input = $input.first();\nconst items = [];\n\ntry {\n  const data = input.json || [];\n  \n  if (!Array.isArray(data)) {\n    return [{ json: { error: true, message: 'Invalid data format' } }];\n  }\n  \n  if (data.length === 0) {\n    return [{ json: { noResults: true } }];\n  }\n  \n  for (const ad of data) {\n    items.push({\n      json: {\n        page_id: ad.page_id || 'unknown',\n        page_name: ad.page_name || 'Unknown',\n        ad_id: ad.ad_id || String(Date.now()),\n        ad_snapshot_url: ad.ad_snapshot_url || '',\n        ad_delivery_start_time: ad.ad_delivery_start_time || null,\n        ad_creative_bodies: ad.ad_creative_bodies || [],\n        ad_creative_link_url: ad.ad_creative_link_url || ''\n      }\n    });\n  }\n  \n  return items;\n  \n} catch (error) {\n  return [{ json: { error: true, errorMessage: error.message } }];\n}"
      },
      "id": "c5a853c6-6193-483c-b7d0-afa385916d04",
