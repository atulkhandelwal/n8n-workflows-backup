    {
      "parameters": {
        "jsCode": "// ── Phase 1: Flag undelivered messages older than 2 hours ─────────────────\nconst MAX_RETRIES = 2;\nconst TWO_HRS_MS  = 2 * 60 * 60 * 1000;\nconst twoHrsAgo   = new Date(Date.now() - TWO_HRS_MS);\n\nconst matched = $input.all().filter(item => {\n  const row        = item.json;\n  const status     = (row.Delivery_Status || '').toLowerCase().trim();\n  const flag       = (row.re_broadcast_flag || '').toUpperCase().trim();\n  const sentAt     = new Date(row.Sent_At);\n  const retryCount = parseInt(row.Retry_Count || '0', 10);\n\n  // Only process rows that have a WAMID — rows without it were never sent via Meta API\n  const hasWamid        = typeof row.WAMID === 'string' && row.WAMID.trim() !== '';\n\n  const isUndelivered   = status === '' || status === 'accepted';\n  const notYetFlagged   = flag !== 'YES' && flag !== 'RETRIED';\n  const olderThan2hrs   = !isNaN(sentAt.getTime()) && sentAt < twoHrsAgo;\n  const underRetryLimit = retryCount < MAX_RETRIES;\n\n  return hasWamid && isUndelivered && notYetFlagged && olderThan2hrs && underRetryLimit;\n});\n\nif (matched.length === 0) {\n  // Return a single marker so the IF node can route FALSE to Phase 2\n  return [{ json: { has_rows: false, _phase: 'phase1_empty' } }];\n}\n\nreturn matched.map(item => ({ json: { ...item.json, has_rows: true } }));"
      },
