    {
      "parameters": {
        "jsCode": "// ── Prepare resend template payload ─────────────────────────────────────────\n// Contact data  → from Loop - Flagged Contacts (previous loop item)\n// Campaign data → from Sheets - Fetch Campaign Details (current $input)\n\nconst contactRow  = $('Loop - Flagged Contacts').item.json;\nconst campaignRow = $input.first().json;\n\nconst phoneNumberId = '934770033042697';\nconst cleanPhone    = String(contactRow.Customer_Phone)\n                        .replace('@c.us', '').replace('+', '').trim();\n\nconst templateName  = campaignRow.WhatsApp_Template_Name;\n\n// Build body parameters from Template_Var_1 to Template_Var_8\nconst templateParams = [];\nfor (let i = 1; i <= 8; i++) {\n  const val = campaignRow[`Template_Var_${i}`];\n  if (val === null || val === undefined || val === '') continue;\n  let text = String(val)\n    .replace(/\\{\\{customer_name\\}\\}/g, contactRow.Customer_Name || 'Valued Customer');\n  templateParams.push({ type: 'text', text });\n}\n\n// Build components array\nconst components = [];\nconst imageUrl = campaignRow.Image_URL;\nif (imageUrl && imageUrl.startsWith('https://')) {\n  components.push({\n    type: 'header',\n    parameters: [{ type: 'image', image: { link: imageUrl } }]\n  });\n}\ncomponents.push({ type: 'body', parameters: templateParams });\n\nconst whatsappBody = {\n  messaging_product: 'whatsapp',\n  to: cleanPhone,\n  type: 'template',\n  template: { name: templateName, language: { code: 'en' }, components }\n};\n\nreturn [{\n  json: {\n    campaign_id:      contactRow.Campaign_ID,\n    customer_phone:   cleanPhone,\n    customer_name:    contactRow.Customer_Name,\n    template_name:    templateName,\n    original_wamid:   contactRow.WAMID,\n    new_retry_count:  parseInt(contactRow.Retry_Count || '0', 10) + 1,\n    whatsappUrl:      `https://graph.facebook.com/v24.0/${phoneNumberId}/messages`,\n    whatsappBody,\n    sent_at:          new Date().toISOString()\n  }\n}];"
      },
      "id": "98a496e5-d963-45b5-a72c-dfbe5b8c6f77",
      "name": "Code - Prepare Resend Template",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
