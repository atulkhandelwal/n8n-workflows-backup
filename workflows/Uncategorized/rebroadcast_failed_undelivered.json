        "jsCode": "const MAX_RETRIES = 2;\n\nconst eligible = $input.all().filter(item => {\n  const retryCount = parseInt(item.json.Retry_Count || '0', 10);\n  const flag = (item.json.re_broadcast_flag || '').toUpperCase().trim();\n  return retryCount < MAX_RETRIES && flag === 'YES';\n});\n\nreturn eligible;"
