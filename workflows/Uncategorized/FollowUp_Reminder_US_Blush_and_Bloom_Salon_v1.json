        "parameters": {
          "jsCode": "const now = DateTime.now().setZone('Asia/Kolkata');\nconst results = [];\n\nfor (const item of $input.all()) {\n\n  const dripOptOut   = (item.json.DripOptOut   || '').trim().toUpperCase();\n  const lastDripSent = (item.json.LastDripSent || '').trim();\n  const raw          = (item.json.LastInboundAt || '').trim();\n\n  // Rule 1: skip if customer has opted out of drip\n  if (dripOptOut === 'YES') continue;\n\n  // Rule 2: skip if reminder was already sent\n  if (lastDripSent.trim() !== '') continue;\n\n  // Rule 3: skip if LastInboundAt is missing\n  if (!raw) continue;\n\n  // Rule 4: TEST MODE — keep only if LastInboundAt was 3–10 minutes ago\n  const lastInbound = DateTime.fromISO(raw, { zone: 'utc' }).setZone('Asia/Kolkata');\n  const minutesAgo = now.diff(lastInbound, 'minutes').minutes;\n\n  if (minutesAgo < 1 || minutesAgo > 10) continue;\n\n  results.push(item);\n}\n\nreturn results;"
        },
